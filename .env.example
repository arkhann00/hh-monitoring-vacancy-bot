# Create a .env file from this template. Never commit the real token.
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Public group: @group_username. Private group: a negative numeric ID, usually -100…
TELEGRAM_CHAT_ID=@your_group
# Special Python-backend search. Keep this URL as-is, or replace it with another
# saved search copied from hh.ru/search/vacancy.
HH_SEARCH_URL=https://hh.ru/search/vacancy?search_field=name&search_field=company_name&search_field=description&text=%28NAME%3Apython+OR+NAME%3Afastapi+OR+NAME%3Adjango%29+AND+%28DESCRIPTION%3Apython+OR+DESCRIPTION%3Adjango+OR+DESCRIPTION%3Afastapi+OR+DESCRIPTION%3Aflask%29+AND+NOT+%D0%BC%D0%B5%D0%BD%D1%82%D0%BE%D1%80+AND+NOT+QA+AND+NOT+%D0%9F%D1%80%D0%B5%D0%BF%D0%BE%D0%B4%D0%B0%D0%B2%D0%B0%D1%82%D0%B5%D0%BB%D1%8C
# How often to check HH. Avoid a value below 60 seconds.
POLL_INTERVAL_SECONDS=300
# Number of newest vacancies examined each check (1..100).
HH_PAGE_SIZE=50
# false means the first run only records current results and does not flood the group.
SEND_EXISTING_ON_START=false
# Optional: receive one combined message per check instead of individual ones.
BATCH_MESSAGES=false

